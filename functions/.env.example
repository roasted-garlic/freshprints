# Loaded automatically on deploy when using --project fresh-prints-dev
# See: https://firebase.google.com/docs/functions/config-env
#
# Do NOT set PORTAL_BASE_URL here for deploys. Portal invite continue URLs and
# proof CTAs resolve from the Firebase project map:
#   fresh-prints-dev  → https://myprintrequest.dev
#   fresh-prints-prod → https://myprintrequest.com
# PORTAL_BASE_URL is accepted only when FUNCTIONS_EMULATOR=true (localhost override).
INVITATION_FROM_EMAIL="Fresh Prints <team@funkyfreshprints.com>"
PROOF_NOTICE_FROM_EMAIL="Fresh Prints <team@funkyfreshprints.com>"
