rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function callerUserExists() {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function callerUser() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function isStaff() {
      return callerUserExists()
        && callerUser().isActive == true
        && callerUser().role in ["owner", "admin", "helper"];
    }

    function isCustomer() {
      return callerUserExists()
        && callerUser().isActive == true
        && callerUser().role == "customer";
    }

    // Leftover Anonymous Auth (no users/{uid} doc) must not break public catalog reads:
    // isStaff()/isCustomer() used to call firestore.get unconditionally and fail the whole rule.
    function isAnonymousAuth() {
      return isSignedIn()
        && request.auth.token.firebase.sign_in_provider == "anonymous";
    }

    function canAccessOwnCustomerUploadPath(userId) {
      return (isCustomer() || isAnonymousAuth()) && userId == request.auth.uid;
    }

    function designIdFromDerivativeFileName(fileName) {
      return fileName.replace('.webp', '');
    }

    // Public catalog browse (#13): ready thumbnails/previews readable without auth.
    // Still requires canonical `{designId}.webp` and a ready design doc — originals stay staff-only.
    function isReadyDesignDerivative(fileName) {
      return isCanonicalDerivativeFileName(fileName)
        && firestore.exists(/databases/(default)/documents/designs/$(designIdFromDerivativeFileName(fileName)))
        && firestore.get(/databases/(default)/documents/designs/$(designIdFromDerivativeFileName(fileName))).data.status == "ready";
    }

    function isCanonicalOriginalFileName(fileName) {
      return fileName.matches('[A-Za-z0-9_-]+\\.png');
    }

    function isCanonicalDerivativeFileName(fileName) {
      return fileName.matches('[A-Za-z0-9_-]+\\.webp');
    }

    function isValidOriginalUpload() {
      // Sync with MAX_SINGLE_PNG_SIZE_BYTES in shared/constants/importValidation.constants.ts (150 MB)
      return request.resource.size < 150 * 1024 * 1024
        && request.resource.contentType == "image/png";
    }

    function isValidDerivativeUpload() {
      return request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType == "image/webp";
    }

    match /originals/{fileName} {
      allow read: if isStaff() && isCanonicalOriginalFileName(fileName);
      allow create: if isStaff()
        && isCanonicalOriginalFileName(fileName)
        && isValidOriginalUpload();
      allow update: if isStaff()
        && isCanonicalOriginalFileName(fileName)
        && isValidOriginalUpload();
      allow delete: if isStaff() && isCanonicalOriginalFileName(fileName);
    }

    match /thumbnails/{fileName} {
      allow read: if (isStaff() && isCanonicalDerivativeFileName(fileName))
        || isReadyDesignDerivative(fileName);
      allow create: if isStaff()
        && isCanonicalDerivativeFileName(fileName)
        && isValidDerivativeUpload();
      allow update: if isStaff()
        && isCanonicalDerivativeFileName(fileName)
        && isValidDerivativeUpload();
      allow delete: if isStaff() && isCanonicalDerivativeFileName(fileName);
    }

    match /previews/{fileName} {
      allow read: if (isStaff() && isCanonicalDerivativeFileName(fileName))
        || isReadyDesignDerivative(fileName);
      allow create: if isStaff()
        && isCanonicalDerivativeFileName(fileName)
        && isValidDerivativeUpload();
      allow update: if isStaff()
        && isCanonicalDerivativeFileName(fileName)
        && isValidDerivativeUpload();
      allow delete: if isStaff() && isCanonicalDerivativeFileName(fileName);
    }

    // Customer uploads (ADR-FP-073). Sync sizes with
    // packages/shared/.../customerUploadLimits.constants.ts
    function isValidCustomerUploadSource() {
      return request.resource.size < 80 * 1024 * 1024
        && request.resource.contentType in ["image/png", "image/webp"];
    }

    function isValidCustomerUploadZip() {
      return request.resource.size < 2 * 1024 * 1024 * 1024
        && request.resource.contentType in [
          "application/zip",
          "application/x-zip-compressed",
          "application/octet-stream"
        ];
    }

    match /customer-uploads/{userId}/batches/{batchId}/archive.zip {
      allow read: if isStaff() || canAccessOwnCustomerUploadPath(userId);
      // ZIP uploads remain registered-customer only (guests are images-only in callables).
      allow create, update: if isCustomer()
        && userId == request.auth.uid
        && isValidCustomerUploadZip();
      allow delete: if isStaff();
    }

    match /customer-uploads/{userId}/{uploadId}/{fileName} {
      allow read: if isStaff() || canAccessOwnCustomerUploadPath(userId);

      allow create, update: if canAccessOwnCustomerUploadPath(userId)
        && fileName == "source"
        && isValidCustomerUploadSource();

      allow delete: if isStaff();
    }

    // Assisted Creation reference / proof assets (Phase 9C).
    // Sync limits with packages/shared/.../assistedCreation.constants.ts
    function isOwnerOrAdmin() {
      return isSignedIn()
        && callerUser().isActive == true
        && callerUser().role in ["owner", "admin"];
    }

    function isValidAssistedCreationImage() {
      return request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType in ["image/jpeg", "image/png", "image/webp"];
    }

    function isValidAssistedCreationProof() {
      return request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType in ["image/jpeg", "image/png", "image/webp"];
    }

    match /assisted-creation/{userId}/pending/{fileId} {
      allow read: if isStaff() || (isCustomer() && userId == request.auth.uid);
      allow create, update: if isCustomer()
        && userId == request.auth.uid
        && isValidAssistedCreationImage();
      allow delete: if isStaff() || (isCustomer() && userId == request.auth.uid);
    }

    match /assisted-creation/{userId}/{requestId}/references/{fileId} {
      allow read: if isStaff() || (isCustomer() && userId == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /assisted-creation/{userId}/{requestId}/proofs/{fileId} {
      allow read: if isStaff() || (isCustomer() && userId == request.auth.uid);
      allow create, update: if isOwnerOrAdmin() && isValidAssistedCreationProof();
      allow delete: if isOwnerOrAdmin();
    }

    // Final HR artwork after proof approval (ADR-FP-110). Same write policy as proofs.
    match /assisted-creation/{userId}/{requestId}/final/{fileId} {
      allow read: if isStaff() || (isCustomer() && userId == request.auth.uid);
      allow create, update: if isOwnerOrAdmin() && isValidAssistedCreationProof();
      allow delete: if isOwnerOrAdmin();
    }

    // Brand logos (Studio + Portal). Sync limits with brandLogoSettings.constants.ts
    function isOwner() {
      return isSignedIn()
        && callerUserExists()
        && callerUser().isActive == true
        && callerUser().role == "owner";
    }

    function isBrandLogoApp(appId) {
      return appId in ["studio", "portal"];
    }

    function isBrandLogoSlot(slotId) {
      return slotId in ["full", "collapsed"];
    }

    function isBrandLogoFileName(fileName) {
      return fileName.matches('^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\\.png$');
    }

    function isValidBrandLogoUpload() {
      return request.resource.size > 0
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType == "image/png";
    }

    match /brand/{appId}/{slotId}/{fileName} {
      allow read: if isBrandLogoApp(appId)
        && isBrandLogoSlot(slotId)
        && isBrandLogoFileName(fileName);
      allow create: if isOwner()
        && isBrandLogoApp(appId)
        && isBrandLogoSlot(slotId)
        && isBrandLogoFileName(fileName)
        && isValidBrandLogoUpload();
      allow update: if false;
      allow delete: if isOwner()
        && isBrandLogoApp(appId)
        && isBrandLogoSlot(slotId)
        && isBrandLogoFileName(fileName);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
