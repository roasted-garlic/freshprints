{
  "name": "fresh-prints",
  "private": true,
  "version": "0.0.0",
  "description": "Fresh Prints — Studio + Portal monorepo",
  "author": "Fresh Prints",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "dev:studio": "vite",
    "dev:portal": "npm run dev --workspace @fresh-prints/portal",
    "tunnel:portal": "cloudflared tunnel --url http://localhost:3000",
    "build": "npm run build:studio",
    "build:studio": "tsc && vite build && electron-builder",
    "build:portal": "npm run build --workspace @fresh-prints/portal",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "firebase": "^12.15.0",
    "lucide-react": "^1.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "main": "dist-electron/main.js",
  "dependencies": {
    "react-rnd": "^10.5.3",
    "react-router-dom": "^7.18.0",
    "sharp": "^0.33.5",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  }
}
