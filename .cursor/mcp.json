{
  "mcpServers": {
    "ScraperAPI": {
      "url": "https://mcp.scraperapi.com/mcp",
      "headers": {
        "Authorization": "Bearer ${env:SCRAPERAPI_API_KEY}"
      }
    },
    "firecrawl-mcp": {
      "command": "npx",
      "args": ["-y", "firecrawl-mcp"],
      "env": {
        "FIRECRAWL_API_KEY": "${env:FIRECRAWL_API_KEY}"
      }
    },
    "etsy": {
      "type": "http",
      "url": "https://mcp.api.etsycloud.com/mcp"
    }
  }
}
