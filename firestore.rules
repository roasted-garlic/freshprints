rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function callerUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function callerIsActive() {
      return isSignedIn() && callerUser().isActive == true;
    }

    function callerRole() {
      return callerUser().role;
    }

    function isOwner() {
      return callerIsActive() && callerRole() == "owner";
    }

    function isAdmin() {
      return callerIsActive() && callerRole() == "admin";
    }

    function isStaff() {
      return callerIsActive() && callerRole() in ["owner", "admin", "helper"];
    }

    function isCustomer() {
      return callerIsActive() && callerRole() == "customer";
    }

    function isCustomerReadableDesign() {
      return isCustomer() && resource.data.status == "ready";
    }

    function isCustomerReadableCategory() {
      return isCustomer() && resource.data.isActive == true;
    }

    function isCustomerReadableTag() {
      return isCustomer() && resource.data.status == "approved";
    }

    function customerOwnsCustomerDoc(customerId) {
      return isCustomer()
        && customerId is string
        && customerId.size() > 0
        && exists(/databases/$(database)/documents/customers/$(customerId))
        && get(/databases/$(database)/documents/customers/$(customerId)).data.userId == request.auth.uid;
    }

    function customerOwnsPrintRequestData(data) {
      return isCustomer()
        && data.customerId is string
        && data.customerId.size() > 0
        && get(/databases/$(database)/documents/customers/$(data.customerId)).data.userId == request.auth.uid;
    }

    function customerOwnsPrintRequestById(printRequestId) {
      return exists(/databases/$(database)/documents/printRequests/$(printRequestId))
        && customerOwnsPrintRequestData(
          get(/databases/$(database)/documents/printRequests/$(printRequestId)).data
        );
    }

    function isCustomerEditablePrintRequestStatus(status) {
      return status in ["draft", "editing"];
    }

    function optionalFieldUnchanged(field) {
      return (!(field in resource.data) && !(field in request.resource.data))
        || (field in resource.data
          && field in request.resource.data
          && request.resource.data[field] == resource.data[field]);
    }

    function customerCanUpdatePrintRequest() {
      return customerOwnsPrintRequestData(resource.data)
        && isCustomerEditablePrintRequestStatus(resource.data.status)
        && isCustomerEditablePrintRequestStatus(request.resource.data.status)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["itemCount", "notes", "updatedBy", "updatedAt"])
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.itemCount is int
        && request.resource.data.itemCount >= 0;
    }

    function customerCanCreatePrintRequestItem(printRequestId) {
      return customerOwnsPrintRequestById(printRequestId)
        && isCustomerEditablePrintRequestStatus(
          get(/databases/$(database)/documents/printRequests/$(printRequestId)).data.status
        );
    }

    function customerCanMutatePrintRequestItem() {
      return customerOwnsPrintRequestById(resource.data.printRequestId)
        && isCustomerEditablePrintRequestStatus(
          get(/databases/$(database)/documents/printRequests/$(resource.data.printRequestId)).data.status
        );
    }

    function customerCanUpdatePrintRequestItem() {
      return customerCanMutatePrintRequestItem()
        && request.resource.data.id == resource.data.id
        && request.resource.data.printRequestId == resource.data.printRequestId
        && request.resource.data.get("designId", "") == resource.data.get("designId", "")
        && request.resource.data.get("sourceType", "") == resource.data.get("sourceType", "")
        && request.resource.data.get("customerUploadId", "") == resource.data.get("customerUploadId", "")
        && request.resource.data.get("titleSnapshot", "") == resource.data.get("titleSnapshot", "")
        && request.resource.data.addedBy == resource.data.addedBy
        && request.resource.data.status == resource.data.status
        && request.resource.data.createdAt == resource.data.createdAt
        && optionalFieldUnchanged("printedAt")
        && optionalFieldUnchanged("printedBy")
        && optionalFieldUnchanged("completedAt");
    }

    function isOwnerOrAdmin() {
      return callerIsActive() && callerRole() in ["owner", "admin"];
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isReadableTeamProfile(role) {
      return role in ["owner", "admin", "helper"];
    }

    function isValidDesignStatus(status) {
      // Catalog statuses plus deprecated queued/printed for legacy document reads.
      return status in ["imported", "processing", "ready", "rejected", "archived", "queued", "printed"];
    }

    function isOptionalString(data, field) {
      return !(field in data) || data[field] == null || data[field] is string;
    }

    function isOptionalNumber(data, field) {
      return !(field in data) || data[field] == null || data[field] is number;
    }

    function isOptionalPositiveStandardPrintInches(data, field) {
      return !(field in data)
        || data[field] == null
        || (data[field] is number && data[field] > 0 && data[field] <= 22);
    }

    function isOptionalBool(data, field) {
      return !(field in data) || data[field] == null || data[field] is bool;
    }

    function isOptionalTimestamp(data, field) {
      return !(field in data) || data[field] == null || data[field] is timestamp;
    }

    function isValidAiReviewStatus(status) {
      return status in ["pending", "approved", "rejected", "needs_review"];
    }

    function isOptionalMap(data, field) {
      return !(field in data) || data[field] is map;
    }

    function clientAiFieldsUnchanged() {
      return request.resource.data.get("aiSuggestions", null) == resource.data.get("aiSuggestions", null)
        && request.resource.data.get("aiAnalysis", null) == resource.data.get("aiAnalysis", null)
        && request.resource.data.get("aiProcessingStage", null) == resource.data.get("aiProcessingStage", null);
    }

    // Owner purge sets these via Admin SDK only — clients must not forge purge state.
    function clientDesignPurgeFieldsUnchanged() {
      return request.resource.data.get("assetsPurgedAt", null) == resource.data.get("assetsPurgedAt", null)
        && request.resource.data.get("assetsPurgedBy", null) == resource.data.get("assetsPurgedBy", null);
    }

    // After assets are purged, clients cannot alter Storage path fields on the design.
    function clientDesignPurgedAssetPathsUnchanged() {
      return !("assetsPurgedAt" in resource.data)
        || (
          request.resource.data.originalPath == resource.data.originalPath
          && request.resource.data.thumbnailPath == resource.data.thumbnailPath
          && request.resource.data.get("previewPath", null) == resource.data.get("previewPath", null)
        );
    }

    function designRequiredFieldsValid(data) {
      return data.keys().hasAll([
          "id",
          "title",
          "tags",
          "status",
          "originalPath",
          "thumbnailPath",
          "uploadedBy",
          "createdBy",
          "updatedBy",
          "queueCount",
          "aiProcessed",
          "aiReviewed",
          "createdAt",
          "updatedAt"
        ])
        && data.id is string
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 200
        && data.tags is list
        && data.status is string
        && isValidDesignStatus(data.status)
        && data.originalPath is string
        && data.thumbnailPath is string
        && data.uploadedBy is string
        && data.createdBy is string
        && data.updatedBy is string
        && data.queueCount is int
        && data.queueCount >= 0
        && data.aiProcessed is bool
        && data.aiReviewed is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && isOptionalString(data, "description")
        && isOptionalString(data, "categoryId")
        && isOptionalString(data, "previewPath")
        && isOptionalString(data, "requestedByCustomerId")
        && isOptionalNumber(data, "width")
        && isOptionalNumber(data, "height")
        && isOptionalNumber(data, "dpi")
        && isOptionalNumber(data, "printWidthInches")
        && isOptionalNumber(data, "printHeightInches")
        && isOptionalBool(data, "printAspectRatioLocked")
        && isOptionalNumber(data, "metadataDpiX")
        && isOptionalNumber(data, "metadataDpiY")
        && isOptionalNumber(data, "effectiveDpi")
        && isOptionalNumber(data, "requestCount")
        && isOptionalNumber(data, "favoriteCount")
        && isOptionalTimestamp(data, "lastRequestedAt")
        && isOptionalString(data, "printSizeSource")
        && isOptionalString(data, "aiReviewStatus")
        && (!("aiReviewStatus" in data) || isValidAiReviewStatus(data.aiReviewStatus))
        && isOptionalTimestamp(data, "aiReviewedAt")
        && isOptionalString(data, "aiReviewedBy")
        && isOptionalString(data, "aiReviewVersion")
        && isOptionalString(data, "aiReviewNotes")
        && isOptionalNumber(data, "aiReviewConfidence")
        && isOptionalString(data, "previousStatus")
        && isOptionalTimestamp(data, "archivedAt")
        && isOptionalString(data, "archivedBy")
        && isOptionalTimestamp(data, "assetsPurgedAt")
        && isOptionalString(data, "assetsPurgedBy")
        && isOptionalString(data, "aiProcessingStage")
        && isOptionalMap(data, "aiSuggestions")
        && isOptionalMap(data, "aiAnalysis");
    }

    function categoryRequiredFieldsValid(data) {
      return data.keys().hasAll([
          "id",
          "name",
          "sortOrder",
          "isActive",
          "createdBy",
          "updatedBy",
          "createdAt",
          "updatedAt"
        ])
        && data.id is string
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 80
        && data.sortOrder is int
        && data.isActive is bool
        && data.createdBy is string
        && data.updatedBy is string
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && isOptionalString(data, "description");
    }

    function isValidCatalogTagStatus(status) {
      return status in ["approved", "archived"];
    }

    function isValidTagStringList(values) {
      return values is list
        && values.size() <= 50;
    }

    function tagRequiredFieldsValid(data) {
      return data.keys().hasOnly([
          "id",
          "name",
          "aliases",
          "preferredWhen",
          "status",
          "createdBy",
          "updatedBy",
          "createdAt",
          "updatedAt"
        ])
        && data.keys().hasAll([
          "id",
          "name",
          "aliases",
          "preferredWhen",
          "status",
          "createdBy",
          "updatedBy",
          "createdAt",
          "updatedAt"
        ])
        && data.id is string
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 40
        && isValidTagStringList(data.aliases)
        && data.preferredWhen is string
        && data.preferredWhen.size() > 0
        && data.preferredWhen.size() <= 500
        && data.status is string
        && isValidCatalogTagStatus(data.status)
        && data.createdBy is string
        && data.updatedBy is string
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPrintRequestStatus(status) {
      return status in ["draft", "active", "editing", "completed", "archived"];
    }

    function isValidPrintRequestOrigin(origin) {
      return origin in ["studio_internal", "studio_customer", "portal_customer"];
    }

    function isValidPrintRequestItemStatus(status) {
      return status in ["pending", "queued", "in_progress", "printed", "done", "canceled"];
    }

    function isValidCustomerUsername(username) {
      return username is string
        && username.size() >= 3
        && username.size() <= 32
        && username.matches("^[a-z0-9][a-z0-9_-]{1,30}[a-z0-9]$")
        && !(username in [
          "internal",
          "admin",
          "owner",
          "support",
          "portal",
          "print",
          "prints",
          "customer",
          "customers",
          "staff",
          "team",
          "freshprints",
          "funkyfreshprints"
        ]);
    }

    function isValidCustomerSignupSource(source) {
      return source in ["studio", "portal"];
    }

    function isOptionalCustomerSignupSource(data, field) {
      return !(field in data) || isValidCustomerSignupSource(data[field]);
    }

    function isValidPrintRequestAssignment(data) {
      return (data.isInternal == true && !("customerId" in data) && !("guestCustomerId" in data))
        || (data.isInternal == false
          && (
            (("customerId" in data) && !("guestCustomerId" in data) && data.customerId is string && data.customerId.size() > 0)
            || (!("customerId" in data) && ("guestCustomerId" in data) && data.guestCustomerId is string && data.guestCustomerId.size() > 0)
          ));
    }

    function isValidPrintRequestOriginAssignment(data) {
      return !("requestOrigin" in data)
        || (data.requestOrigin == "studio_internal"
          && data.isInternal == true
          && !("customerId" in data)
          && !("guestCustomerId" in data))
        || ((data.requestOrigin == "studio_customer" || data.requestOrigin == "portal_customer")
          && data.isInternal == false
          && (
            (("customerId" in data) && !("guestCustomerId" in data) && data.customerId is string && data.customerId.size() > 0)
            || (!("customerId" in data) && ("guestCustomerId" in data) && data.guestCustomerId is string && data.guestCustomerId.size() > 0)
          ));
    }

    function printRequestRequiredFieldsValid(data) {
      return data.keys().hasOnly([
          "name",
          "customerId",
          "guestCustomerId",
          "isInternal",
          "requestOrigin",
          "status",
          "itemCount",
          "requestSequenceNumber",
          "customerUsernameSnapshot",
          "customerDisplayNameSnapshot",
          "internalBaseName",
          "nameFormatVersion",
          "notes",
          "createdBy",
          "updatedBy",
          "createdAt",
          "updatedAt"
        ])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 200
        && isOptionalString(data, "customerId")
        && isOptionalString(data, "guestCustomerId")
        && data.isInternal is bool
        && (!("requestOrigin" in data) || (data.requestOrigin is string && isValidPrintRequestOrigin(data.requestOrigin)))
        && data.status is string
        && isValidPrintRequestStatus(data.status)
        && data.itemCount is int
        && data.itemCount >= 0
        && isOptionalNumber(data, "requestSequenceNumber")
        && isOptionalString(data, "customerUsernameSnapshot")
        && isOptionalString(data, "customerDisplayNameSnapshot")
        && isOptionalString(data, "internalBaseName")
        && isOptionalString(data, "nameFormatVersion")
        && isOptionalString(data, "notes")
        && data.createdBy is string
        && data.updatedBy is string
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && isValidPrintRequestAssignment(data)
        && isValidPrintRequestOriginAssignment(data);
    }

    function isCatalogPrintRequestItem(data) {
      return !("sourceType" in data) || data.sourceType == "catalog_design";
    }

    function isUploadPrintRequestItem(data) {
      return data.sourceType == "customer_upload";
    }

    function printRequestItemRequiredFieldsValid(data) {
      return data.keys().hasOnly([
          "id",
          "printRequestId",
          "designId",
          "sourceType",
          "customerUploadId",
          "titleSnapshot",
          "quantity",
          "printWidthInches",
          "printHeightInches",
          "sizeLabel",
          "sortOrder",
          "notes",
          "status",
          "addedBy",
          "printedAt",
          "printedBy",
          "completedAt",
          "createdAt",
          "updatedAt"
        ])
        && data.id is string
        && data.id.size() > 0
        && data.printRequestId is string
        && data.printRequestId.size() > 0
        && data.quantity is int
        && data.quantity > 0
        && isOptionalPositiveStandardPrintInches(data, "printWidthInches")
        && isOptionalPositiveStandardPrintInches(data, "printHeightInches")
        && isOptionalString(data, "sizeLabel")
        && isOptionalNumber(data, "sortOrder")
        && isOptionalString(data, "notes")
        && data.status is string
        && isValidPrintRequestItemStatus(data.status)
        && data.addedBy is string
        && data.addedBy.size() > 0
        && isOptionalTimestamp(data, "printedAt")
        && isOptionalString(data, "printedBy")
        && isOptionalTimestamp(data, "completedAt")
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (
          (
            isCatalogPrintRequestItem(data)
            && data.designId is string
            && data.designId.size() > 0
            && !("customerUploadId" in data)
          )
          || (
            isUploadPrintRequestItem(data)
            && !("designId" in data)
            && data.customerUploadId is string
            && data.customerUploadId.size() > 0
            && isOptionalString(data, "titleSnapshot")
          )
        );
    }

    function printRequestParentExists(printRequestId) {
      return exists(/databases/$(database)/documents/printRequests/$(printRequestId));
    }

    function isReadyDesign(designId) {
      return exists(/databases/$(database)/documents/designs/$(designId))
        && get(/databases/$(database)/documents/designs/$(designId)).data.status == "ready";
    }

    function customerRequiredFieldsValid(data) {
      return data.keys().hasOnly([
          "id",
          "userId",
          "displayName",
          "username",
          "email",
          "notes",
          "isGuest",
          "totalPrintRequests",
          "nextPrintRequestSequence",
          "totalRequests",
          "totalApprovedRequests",
          "usernameUpdatedAt",
          "signupSource",
          "assistedProofEmailOptIn",
          "assistedProofEmailOptInUpdatedAt",
          "assistedBrowserPushOptIn",
          "assistedBrowserPushOptInUpdatedAt",
          "createdAt",
          "updatedAt"
        ])
        && data.id is string
        && data.id.size() > 0
        && data.displayName is string
        && data.displayName.size() > 0
        && isValidCustomerUsername(data.username)
        && data.isGuest is bool
        && data.totalPrintRequests is int
        && data.totalPrintRequests >= 0
        && (!("assistedProofEmailOptIn" in data) || data.assistedProofEmailOptIn is bool)
        && (!("assistedProofEmailOptInUpdatedAt" in data) || data.assistedProofEmailOptInUpdatedAt is timestamp)
        && (!("assistedBrowserPushOptIn" in data) || data.assistedBrowserPushOptIn is bool)
        && (!("assistedBrowserPushOptInUpdatedAt" in data) || data.assistedBrowserPushOptInUpdatedAt is timestamp)
        && data.nextPrintRequestSequence is int
        && data.nextPrintRequestSequence >= 1
        && isOptionalString(data, "userId")
        && isOptionalString(data, "email")
        && isOptionalString(data, "notes")
        && isOptionalNumber(data, "totalRequests")
        && isOptionalNumber(data, "totalApprovedRequests")
        && isOptionalTimestamp(data, "usernameUpdatedAt")
        && isOptionalCustomerSignupSource(data, "signupSource")
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function customerUsernameReservationFieldsValid(data, username) {
      return data.keys().hasOnly([
          "customerId",
          "createdAt",
          "updatedAt"
        ])
        && isValidCustomerUsername(username)
        && data.customerId is string
        && data.customerId.size() > 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function printRequestCounterFieldsValid(data) {
      return data.keys().hasOnly([
          "nextInternalRequestSequence",
          "createdAt",
          "updatedAt"
        ])
        && data.nextInternalRequestSequence is int
        && data.nextInternalRequestSequence >= 1
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUpcomingShowSource(source) {
      return source in ["whatnot"];
    }

    function isValidUpcomingShowStatus(status) {
      return status in ["scheduled", "rescheduled", "live", "completed", "canceled", "missing_upstream", "archived"];
    }

    function isValidUpcomingShowSyncStatus(syncStatus) {
      return syncStatus in ["idle", "syncing", "succeeded", "failed"];
    }

    function isValidShowProductionStatus(status) {
      return status in ["open", "full", "printing", "fully_printed", "completed", "archived", "canceled"];
    }

    function upcomingShowRequiredFieldsValid(data) {
      return data.keys().hasOnly([
          "source",
          "whatnotShowId",
          "whatnotUrl",
          "title",
          "scheduledStartAt",
          "status",
          "syncStatus",
          "syncError",
          "lastSyncedAt",
          "lastSeenAt",
          "sourceBaseUrlSnapshot",
          "lastSeenInAssistedImportAt",
          "notes",
          "isArchived",
          "productionStatus",
          "maxTotalQuantity",
          "maxQuantityOverridden",
          "allocatedQuantity",
          "accumulatedPrintMs",
          "activePrintStartedAt",
          "printStartedAt",
          "printPausedAt",
          "printFinishedAt",
          "printFinishedBy",
          "createdBy",
          "updatedBy",
          "createdAt",
          "updatedAt"
        ])
        && isValidUpcomingShowSource(data.source)
        && data.whatnotShowId is string
        && data.whatnotShowId.size() > 0
        && isOptionalString(data, "whatnotUrl")
        && isOptionalString(data, "title")
        && isOptionalTimestamp(data, "scheduledStartAt")
        && isValidUpcomingShowStatus(data.status)
        && isValidUpcomingShowSyncStatus(data.syncStatus)
        && isOptionalString(data, "syncError")
        && isOptionalTimestamp(data, "lastSyncedAt")
        && isOptionalTimestamp(data, "lastSeenAt")
        && isOptionalString(data, "sourceBaseUrlSnapshot")
        && isOptionalTimestamp(data, "lastSeenInAssistedImportAt")
        && isOptionalString(data, "notes")
        && data.isArchived is bool
        && isValidShowProductionStatus(data.productionStatus)
        && isOptionalNumber(data, "maxTotalQuantity")
        && data.maxQuantityOverridden is bool
        && data.allocatedQuantity is number
        && data.allocatedQuantity >= 0
        && isOptionalNumber(data, "accumulatedPrintMs")
        && (!("accumulatedPrintMs" in data) || data.accumulatedPrintMs >= 0)
        && isOptionalTimestamp(data, "activePrintStartedAt")
        && isOptionalTimestamp(data, "printStartedAt")
        && isOptionalTimestamp(data, "printPausedAt")
        && isOptionalTimestamp(data, "printFinishedAt")
        && isOptionalString(data, "printFinishedBy")
        && isOptionalString(data, "createdBy")
        && isOptionalString(data, "updatedBy")
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidShowAllocationStatus(status) {
      return status in ["pending", "queued", "in_progress", "printed", "done", "canceled"];
    }

    function isCatalogShowAllocation(data) {
      return !("sourceType" in data) || data.sourceType == "catalog_design";
    }

    function isUploadShowAllocation(data) {
      return data.sourceType == "customer_upload";
    }

    function showAllocationRequiredFieldsValid(data) {
      return data.keys().hasOnly([
          "upcomingShowId",
          "printRequestId",
          "printRequestItemId",
          "designId",
          "sourceType",
          "customerUploadId",
          "customerId",
          "requestNameSnapshot",
          "requestOriginSnapshot",
          "designTitleSnapshot",
          "allocatedQuantity",
          "sourceItemQuantitySnapshot",
          "printWidthInches",
          "printHeightInches",
          "sizeLabel",
          "notes",
          "status",
          "addedBy",
          "updatedBy",
          "queuedAt",
          "queuedBy",
          "printedAt",
          "printedBy",
          "completedAt",
          "completedBy",
          "canceledAt",
          "canceledBy",
          "createdAt",
          "updatedAt"
        ])
        && data.upcomingShowId is string
        && data.upcomingShowId.size() > 0
        && data.printRequestId is string
        && data.printRequestId.size() > 0
        && data.printRequestItemId is string
        && data.printRequestItemId.size() > 0
        && isOptionalString(data, "customerId")
        && data.requestNameSnapshot is string
        && data.requestNameSnapshot.size() > 0
        && (!("requestOriginSnapshot" in data) || isValidPrintRequestOrigin(data.requestOriginSnapshot))
        && isOptionalString(data, "designTitleSnapshot")
        && data.allocatedQuantity is int
        && data.allocatedQuantity > 0
        && data.sourceItemQuantitySnapshot is int
        && data.sourceItemQuantitySnapshot > 0
        && isOptionalPositiveStandardPrintInches(data, "printWidthInches")
        && isOptionalPositiveStandardPrintInches(data, "printHeightInches")
        && isOptionalString(data, "sizeLabel")
        && isOptionalString(data, "notes")
        && isValidShowAllocationStatus(data.status)
        && data.addedBy is string
        && data.addedBy.size() > 0
        && data.updatedBy is string
        && data.updatedBy.size() > 0
        && isOptionalTimestamp(data, "queuedAt")
        && isOptionalString(data, "queuedBy")
        && isOptionalTimestamp(data, "printedAt")
        && isOptionalString(data, "printedBy")
        && isOptionalTimestamp(data, "completedAt")
        && isOptionalString(data, "completedBy")
        && isOptionalTimestamp(data, "canceledAt")
        && isOptionalString(data, "canceledBy")
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (
          (
            isCatalogShowAllocation(data)
            && data.designId is string
            && data.designId.size() > 0
            && !("customerUploadId" in data)
          )
          || (
            isUploadShowAllocation(data)
            && !("designId" in data)
            && data.customerUploadId is string
            && data.customerUploadId.size() > 0
          )
        );
    }

    match /users/{userId} {
      allow read: if isSelf(userId)
        || (isOwner() && isReadableTeamProfile(resource.data.role))
        || (isAdmin() && resource.data.role in ["admin", "helper"]);

      allow create, update, delete: if false;
    }

    match /designs/{designId} {
      allow read: if isStaff() || isCustomerReadableDesign();

      allow create: if isStaff()
        && designRequiredFieldsValid(request.resource.data)
        && request.resource.data.id == designId
        && request.resource.data.uploadedBy == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && !("assetsPurgedAt" in request.resource.data)
        && !("assetsPurgedBy" in request.resource.data);

      allow update: if isStaff()
        && designRequiredFieldsValid(request.resource.data)
        && request.resource.data.id == designId
        && request.resource.data.id == resource.data.id
        && request.resource.data.uploadedBy == resource.data.uploadedBy
        && (!("createdBy" in resource.data) || request.resource.data.createdBy == resource.data.createdBy)
        && (!("createdAt" in resource.data) || request.resource.data.createdAt == resource.data.createdAt)
        && request.resource.data.updatedBy == request.auth.uid
        && clientAiFieldsUnchanged()
        && clientDesignPurgeFieldsUnchanged()
        && clientDesignPurgedAssetPathsUnchanged();

      allow delete: if false;
    }

    match /categories/{categoryId} {
      allow read: if isStaff() || isCustomerReadableCategory();

      allow create: if isOwnerOrAdmin()
        && categoryRequiredFieldsValid(request.resource.data)
        && request.resource.data.id == categoryId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid;

      allow update: if isOwnerOrAdmin()
        && categoryRequiredFieldsValid(request.resource.data)
        && request.resource.data.id == categoryId
        && request.resource.data.id == resource.data.id
        && (!("createdBy" in resource.data) || request.resource.data.createdBy == resource.data.createdBy)
        && (!("createdAt" in resource.data) || request.resource.data.createdAt == resource.data.createdAt)
        && request.resource.data.updatedBy == request.auth.uid;

      allow delete: if false;
    }

    match /tags/{tagId} {
      allow read: if isStaff() || isCustomerReadableTag();

      allow create: if isOwnerOrAdmin()
        && tagRequiredFieldsValid(request.resource.data)
        && request.resource.data.id == tagId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid;

      allow update: if isOwnerOrAdmin()
        && tagRequiredFieldsValid(request.resource.data)
        && request.resource.data.id == tagId
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedBy == request.auth.uid;

      allow delete: if false;
    }

    match /customers/{customerId} {
      allow read: if isStaff()
        || (isCustomer() && resource.data.userId == request.auth.uid);

      allow create: if isStaff()
        && customerRequiredFieldsValid(request.resource.data)
        && request.resource.data.id == customerId
        && request.resource.data.signupSource == "studio";

      allow update: if isStaff()
        && customerRequiredFieldsValid(request.resource.data)
        && request.resource.data.id == customerId
        && request.resource.data.id == resource.data.id
        && (!("userId" in resource.data) || request.resource.data.userId == resource.data.userId)
        && (!("isGuest" in resource.data) || request.resource.data.isGuest == resource.data.isGuest)
        && (!("signupSource" in resource.data) || request.resource.data.signupSource == resource.data.signupSource)
        && (!("createdAt" in resource.data) || request.resource.data.createdAt == resource.data.createdAt)
        || (
          isCustomer()
          && resource.data.userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              "assistedProofEmailOptIn",
              "assistedProofEmailOptInUpdatedAt",
              "assistedBrowserPushOptIn",
              "assistedBrowserPushOptInUpdatedAt",
              "updatedAt",
            ])
          && (!("assistedProofEmailOptIn" in request.resource.data)
            || request.resource.data.assistedProofEmailOptIn is bool)
          && (!("assistedProofEmailOptInUpdatedAt" in request.resource.data)
            || request.resource.data.assistedProofEmailOptInUpdatedAt is timestamp)
          && (!("assistedBrowserPushOptIn" in request.resource.data)
            || request.resource.data.assistedBrowserPushOptIn is bool)
          && (!("assistedBrowserPushOptInUpdatedAt" in request.resource.data)
            || request.resource.data.assistedBrowserPushOptInUpdatedAt is timestamp)
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.id == resource.data.id
          && request.resource.data.userId == resource.data.userId
        );

      allow delete: if false;

      match /webPushSubscriptions/{subscriptionId} {
        allow read: if isStaff() || customerOwnsCustomerDoc(customerId);
        allow create, update, delete: if false;
      }

      match /favorites/{designId} {
        allow read: if isStaff() || customerOwnsCustomerDoc(customerId);

        allow create: if customerOwnsCustomerDoc(customerId)
          && request.resource.data.designId == designId
          && request.resource.data.customerId == customerId
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt is timestamp
          && request.resource.data.keys().hasOnly(["designId", "customerId", "createdAt", "createdBy"]);

        allow update: if false;

        allow delete: if isStaff() || customerOwnsCustomerDoc(customerId);
      }
    }

    match /customerUsernames/{username} {
      allow read: if isStaff();

      allow create, update: if isStaff()
        && customerUsernameReservationFieldsValid(request.resource.data, username);

      allow delete: if isStaff();
    }

    match /counters/{counterId} {
      allow read: if isStaff() && counterId == "printRequests";

      allow create, update: if isStaff()
        && counterId == "printRequests"
        && printRequestCounterFieldsValid(request.resource.data);

      allow delete: if false;
    }

    match /printRequests/{printRequestId} {
      allow read: if isStaff() || customerOwnsPrintRequestData(resource.data);

      allow create: if isStaff()
        && printRequestRequiredFieldsValid(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid;

      allow update: if isStaff()
        && printRequestRequiredFieldsValid(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedBy == request.auth.uid
        || customerCanUpdatePrintRequest()
        && printRequestRequiredFieldsValid(request.resource.data);

      allow delete: if isStaff();
    }

    function customerOwnsCustomerUpload(uploadId) {
      return exists(/databases/$(database)/documents/customerUploads/$(uploadId))
        && get(/databases/$(database)/documents/customerUploads/$(uploadId)).data.customerUid
          == request.auth.uid;
    }

    function customerUploadLinkedToPrintRequest(uploadId, printRequestId) {
      return exists(/databases/$(database)/documents/customerUploads/$(uploadId))
        && get(/databases/$(database)/documents/customerUploads/$(uploadId)).data.printRequestId
          == printRequestId;
    }

    function customerCanCreateUploadPrintRequestItem(data) {
      return isCustomer()
        && printRequestItemRequiredFieldsValid(data)
        && isUploadPrintRequestItem(data)
        && data.id is string
        && data.addedBy == request.auth.uid
        && data.status == "pending"
        && customerCanCreatePrintRequestItem(data.printRequestId)
        && customerOwnsCustomerUpload(data.customerUploadId)
        && customerUploadLinkedToPrintRequest(data.customerUploadId, data.printRequestId);
    }

    function staffCanCreateUploadPrintRequestItem(data) {
      return isStaff()
        && printRequestItemRequiredFieldsValid(data)
        && isUploadPrintRequestItem(data)
        && data.id is string
        && data.addedBy == request.auth.uid
        && printRequestParentExists(data.printRequestId)
        && exists(/databases/$(database)/documents/customerUploads/$(data.customerUploadId));
    }

    function showAllocationSourceIdentityUnchanged() {
      return (
          isCatalogShowAllocation(resource.data)
          && isCatalogShowAllocation(request.resource.data)
          && request.resource.data.designId == resource.data.designId
        )
        || (
          isUploadShowAllocation(resource.data)
          && isUploadShowAllocation(request.resource.data)
          && request.resource.data.customerUploadId == resource.data.customerUploadId
        );
    }

    function gangSheetItemSourceIdentityUnchanged() {
      return (
          (!("sourceType" in resource.data) || resource.data.sourceType == "catalog_design")
          && (!("sourceType" in request.resource.data) || request.resource.data.sourceType == "catalog_design")
          && request.resource.data.designId == resource.data.designId
        )
        || (
          resource.data.sourceType == "customer_upload"
          && request.resource.data.sourceType == "customer_upload"
          && request.resource.data.customerUploadId == resource.data.customerUploadId
        );
    }

    match /printRequestItems/{printRequestItemId} {
      allow read: if isStaff()
        || (isCustomer() && customerOwnsPrintRequestById(resource.data.printRequestId));

      allow create: if isStaff()
        && printRequestItemRequiredFieldsValid(request.resource.data)
        && isCatalogPrintRequestItem(request.resource.data)
        && request.resource.data.id == printRequestItemId
        && request.resource.data.addedBy == request.auth.uid
        && printRequestParentExists(request.resource.data.printRequestId)
        && isReadyDesign(request.resource.data.designId)
        || staffCanCreateUploadPrintRequestItem(request.resource.data)
        && request.resource.data.id == printRequestItemId
        || isCustomer()
        && printRequestItemRequiredFieldsValid(request.resource.data)
        && isCatalogPrintRequestItem(request.resource.data)
        && request.resource.data.id == printRequestItemId
        && request.resource.data.addedBy == request.auth.uid
        && request.resource.data.status == "pending"
        && customerCanCreatePrintRequestItem(request.resource.data.printRequestId)
        && isReadyDesign(request.resource.data.designId)
        || customerCanCreateUploadPrintRequestItem(request.resource.data)
        && request.resource.data.id == printRequestItemId;

      allow update: if isStaff()
        && printRequestItemRequiredFieldsValid(request.resource.data)
        && request.resource.data.id == printRequestItemId
        && request.resource.data.id == resource.data.id
        && request.resource.data.printRequestId == resource.data.printRequestId
        && request.resource.data.get("designId", "") == resource.data.get("designId", "")
        && request.resource.data.get("sourceType", "") == resource.data.get("sourceType", "")
        && request.resource.data.get("customerUploadId", "") == resource.data.get("customerUploadId", "")
        && request.resource.data.addedBy == resource.data.addedBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt is timestamp
        && printRequestParentExists(request.resource.data.printRequestId)
        && (
          isUploadPrintRequestItem(resource.data)
          || isReadyDesign(request.resource.data.designId)
        )
        || isCustomer()
        && printRequestItemRequiredFieldsValid(request.resource.data)
        && customerCanUpdatePrintRequestItem()
        && (
          (
            isUploadPrintRequestItem(resource.data)
            && isUploadPrintRequestItem(request.resource.data)
          )
          || (
            isCatalogPrintRequestItem(resource.data)
            && isReadyDesign(request.resource.data.designId)
          )
        );

      allow delete: if isStaff()
        || (isCustomer() && customerCanMutatePrintRequestItem());
    }

    match /upcomingShows/{upcomingShowId} {
      allow read: if isStaff();

      allow create: if isStaff()
        && upcomingShowRequiredFieldsValid(request.resource.data)
        && request.resource.data.updatedBy == request.auth.uid;

      allow update: if isStaff()
        && upcomingShowRequiredFieldsValid(request.resource.data)
        && request.resource.data.source == resource.data.source
        && request.resource.data.whatnotShowId == resource.data.whatnotShowId
        && (!("createdBy" in resource.data) || request.resource.data.createdBy == resource.data.createdBy)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedBy == request.auth.uid;

      allow delete: if isStaff();
    }

    function isValidGangSheetStatus(status) {
      return status in ["draft", "ready", "printing", "paused", "finished", "archived"];
    }

    function gangSheetRequiredFieldsValid(data) {
      return data.keys().hasOnly([
          "upcomingShowId",
          "title",
          "status",
          "sheetWidthInches",
          "sheetHeightInches",
          "dpi",
          "backgroundColor",
          "itemCount",
          "totalQuantity",
          "accumulatedPrintMs",
          "activePrintStartedAt",
          "printStartedAt",
          "printPausedAt",
          "printFinishedAt",
          "printFinishedBy",
          "lastResetAt",
          "lastResetBy",
          "lastExportedAt",
          "lastExportedBy",
          "lastExportFileName",
          "sheetNumber",
          "createdBy",
          "updatedBy",
          "createdAt",
          "updatedAt"
        ])
        && data.upcomingShowId is string
        && data.upcomingShowId.size() > 0
        && isOptionalString(data, "title")
        && isValidGangSheetStatus(data.status)
        && data.sheetWidthInches is number
        && data.sheetWidthInches > 0
        && data.sheetHeightInches is number
        && data.sheetHeightInches > 0
        && data.dpi is number
        && data.dpi > 0
        && isOptionalString(data, "backgroundColor")
        && data.itemCount is int
        && data.itemCount >= 0
        && data.totalQuantity is int
        && data.totalQuantity >= 0
        && data.accumulatedPrintMs is number
        && data.accumulatedPrintMs >= 0
        && isOptionalTimestamp(data, "activePrintStartedAt")
        && isOptionalTimestamp(data, "printStartedAt")
        && isOptionalTimestamp(data, "printPausedAt")
        && isOptionalTimestamp(data, "printFinishedAt")
        && isOptionalString(data, "printFinishedBy")
        && isOptionalTimestamp(data, "lastResetAt")
        && isOptionalString(data, "lastResetBy")
        && isOptionalTimestamp(data, "lastExportedAt")
        && isOptionalString(data, "lastExportedBy")
        && isOptionalString(data, "lastExportFileName")
        && data.sheetNumber is int
        && data.sheetNumber > 0
        && data.createdBy is string
        && data.updatedBy is string
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function gangSheetItemRequiredFieldsValid(data) {
      return data.keys().hasOnly([
          "gangSheetId",
          "upcomingShowId",
          "showAllocationId",
          "printRequestId",
          "printRequestItemId",
          "designId",
          "sourceType",
          "customerUploadId",
          "copyIndex",
          "sourceQuantitySnapshot",
          "designTitleSnapshot",
          "requestNameSnapshot",
          "originalPathSnapshot",
          "xInches",
          "yInches",
          "widthInches",
          "heightInches",
          "rotationDegrees",
          "flipHorizontal",
          "flipVertical",
          "zIndex",
          "createdAt",
          "updatedAt"
        ])
        && data.gangSheetId is string
        && data.gangSheetId.size() > 0
        && data.upcomingShowId is string
        && data.upcomingShowId.size() > 0
        && data.showAllocationId is string
        && data.showAllocationId.size() > 0
        && data.printRequestId is string
        && data.printRequestId.size() > 0
        && data.printRequestItemId is string
        && data.printRequestItemId.size() > 0
        && data.copyIndex is int
        && data.copyIndex >= 0
        && data.sourceQuantitySnapshot is int
        && data.sourceQuantitySnapshot > 0
        && isOptionalString(data, "designTitleSnapshot")
        && data.requestNameSnapshot is string
        && data.requestNameSnapshot.size() > 0
        && data.originalPathSnapshot is string
        && (
          data.originalPathSnapshot.matches("^/originals/[A-Za-z0-9_-]+\\.png$")
          || data.originalPathSnapshot.matches("^/customer-uploads/[A-Za-z0-9_-]+/[A-Za-z0-9_-]+/production\\.png$")
        )
        && (
          (
            (!("sourceType" in data) || data.sourceType == "catalog_design")
            && data.designId is string
            && data.designId.size() > 0
            && !("customerUploadId" in data)
            && data.originalPathSnapshot.matches("^/originals/[A-Za-z0-9_-]+\\.png$")
          )
          || (
            data.sourceType == "customer_upload"
            && !("designId" in data)
            && data.customerUploadId is string
            && data.customerUploadId.size() > 0
            && data.originalPathSnapshot.matches("^/customer-uploads/[A-Za-z0-9_-]+/[A-Za-z0-9_-]+/production\\.png$")
          )
        )
        && data.xInches is number
        && data.xInches >= 0
        && data.yInches is number
        && data.yInches >= 0
        && data.widthInches is number
        && data.widthInches > 0
        && data.heightInches is number
        && data.heightInches > 0
        && data.rotationDegrees is number
        && data.flipHorizontal is bool
        && data.flipVertical is bool
        && data.zIndex is int
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /gangSheets/{gangSheetId} {
      allow read: if isStaff();

      allow create: if isStaff()
        && gangSheetRequiredFieldsValid(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid;

      allow update: if isStaff()
        && gangSheetRequiredFieldsValid(request.resource.data)
        && request.resource.data.upcomingShowId == resource.data.upcomingShowId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedBy == request.auth.uid;

      allow delete: if isStaff();
    }

    match /gangSheetItems/{gangSheetItemId} {
      allow read: if isStaff();

      allow create: if isStaff()
        && gangSheetItemRequiredFieldsValid(request.resource.data);

      allow update: if isStaff()
        && gangSheetItemRequiredFieldsValid(request.resource.data)
        && request.resource.data.gangSheetId == resource.data.gangSheetId
        && request.resource.data.upcomingShowId == resource.data.upcomingShowId
        && request.resource.data.showAllocationId == resource.data.showAllocationId
        && gangSheetItemSourceIdentityUnchanged()
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if isStaff();
    }

    match /showAllocations/{showAllocationId} {
      allow read: if isStaff()
        || (isCustomer() && customerOwnsPrintRequestById(resource.data.printRequestId));

      allow create: if isStaff()
        && showAllocationRequiredFieldsValid(request.resource.data)
        && request.resource.data.addedBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid;

      allow update: if isStaff()
        && showAllocationRequiredFieldsValid(request.resource.data)
        && request.resource.data.upcomingShowId == resource.data.upcomingShowId
        && request.resource.data.printRequestId == resource.data.printRequestId
        && request.resource.data.printRequestItemId == resource.data.printRequestItemId
        && showAllocationSourceIdentityUnchanged()
        && request.resource.data.addedBy == resource.data.addedBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedBy == request.auth.uid;

      allow delete: if isStaff();
    }

    function isValidWhatnotAssistedImportStatus(value) {
      return value == "succeeded" || value == "failed";
    }

    function isOptionalWhatnotAssistedImportStatus(data, field) {
      return !(field in data) || isValidWhatnotAssistedImportStatus(data[field]);
    }

    function showQueueSettingsFieldsValid(data) {
      return data.keys().hasOnly([
          "defaultMaxTotalQuantity",
          "whatnotShowBaseUrl",
          "lastWhatnotAssistedImportAt",
          "lastWhatnotAssistedImportStatus",
          "lastWhatnotAssistedImportSummary",
          "lastWhatnotAssistedImportError",
          "gangSheetWidthInches",
          "gangSheetSideMarginInches",
          "gangSheetTopBottomMarginInches",
          "gangSheetGutterInches",
          "gangSheetMaxLengthInches",
          "gangSheetLabelFontSizePx",
          "updatedBy",
          "updatedAt"
        ])
        && isOptionalNumber(data, "defaultMaxTotalQuantity")
        && isOptionalString(data, "whatnotShowBaseUrl")
        && isOptionalTimestamp(data, "lastWhatnotAssistedImportAt")
        && isOptionalWhatnotAssistedImportStatus(data, "lastWhatnotAssistedImportStatus")
        && isOptionalMap(data, "lastWhatnotAssistedImportSummary")
        && isOptionalString(data, "lastWhatnotAssistedImportError")
        && isOptionalNumber(data, "gangSheetWidthInches")
        && isOptionalNumber(data, "gangSheetSideMarginInches")
        && isOptionalNumber(data, "gangSheetTopBottomMarginInches")
        && isOptionalNumber(data, "gangSheetGutterInches")
        && isOptionalNumber(data, "gangSheetMaxLengthInches")
        && isOptionalNumber(data, "gangSheetLabelFontSizePx")
        && isOptionalString(data, "updatedBy")
        && data.updatedAt is timestamp;
    }

    match /settings/showQueue {
      allow read: if isStaff();

      allow create, update: if isStaff()
        && showQueueSettingsFieldsValid(request.resource.data)
        && request.resource.data.updatedBy == request.auth.uid;

      allow delete: if false;
    }

    match /settings/emailProviders {
      allow read: if isOwner();
      allow write: if false;
    }

    match /settings/{settingId} {
      allow read: if isStaff() && settingId == "aiEnrichment";
      allow write: if false;
    }

    function isValidStaffInboxAckKind(kind) {
      return kind in ["portal_queued", "show_queue_full"];
    }

    function isOptionalPrintRequestListTab(data, field) {
      return !(field in data)
        || data[field] in ["working", "queued", "printing", "printed"];
    }

    function staffInboxAckFieldsValid(data) {
      return data.keys().hasOnly([
          "userId",
          "itemId",
          "kind",
          "title",
          "subtitle",
          "printRequestId",
          "upcomingShowId",
          "printRequestTab",
          "occurredAtMillis",
          "acknowledgedByUserId",
          "acknowledgedByDisplayName",
          "acknowledgedAt",
          "createdAt",
          "updatedAt"
        ])
        && data.userId is string
        && data.userId.size() > 0
        && data.itemId is string
        && data.itemId.size() > 0
        && isValidStaffInboxAckKind(data.kind)
        && data.title is string
        && data.title.size() > 0
        && data.subtitle is string
        && data.subtitle.size() > 0
        && isOptionalString(data, "printRequestId")
        && isOptionalString(data, "upcomingShowId")
        && isOptionalPrintRequestListTab(data, "printRequestTab")
        && data.occurredAtMillis is number
        && data.occurredAtMillis >= 0
        && (
          !("acknowledgedByUserId" in data)
          || (
            data.acknowledgedByUserId is string
            && data.acknowledgedByUserId == data.userId
          )
        )
        && (
          !("acknowledgedByDisplayName" in data)
          || (
            data.acknowledgedByDisplayName is string
            && data.acknowledgedByDisplayName.size() > 0
            && data.acknowledgedByDisplayName.size() <= 120
          )
        )
        && data.acknowledgedAt is timestamp
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function staffInboxAlertDeliveryFieldsValid(data) {
      return data.keys().hasOnly([
          "userId",
          "itemId",
          "kind",
          "occurredAtMillis",
          "soundPlayedAt",
          "createdAt",
          "updatedAt"
        ])
        && data.userId is string
        && data.userId.size() > 0
        && data.itemId is string
        && data.itemId.size() > 0
        && isValidStaffInboxAckKind(data.kind)
        && data.occurredAtMillis is number
        && data.occurredAtMillis >= 0
        && data.soundPlayedAt is timestamp
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /staffInboxAcks/{ackId} {
      allow read: if isStaff()
        && resource.data.userId == request.auth.uid;

      allow create: if isStaff()
        && request.resource.data.userId == request.auth.uid
        && staffInboxAckFieldsValid(request.resource.data);

      allow update: if false;

      allow delete: if isStaff()
        && resource.data.userId == request.auth.uid;
    }

    function assistedCreationUpdateAckFieldsValid(data) {
      return data.keys().hasOnly([
          "userId",
          "requestId",
          "readThroughAt",
          "createdAt",
          "updatedAt"
        ])
        && data.userId is string
        && data.userId.size() > 0
        && data.requestId is string
        && data.requestId.size() > 0
        && data.readThroughAt is timestamp
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /assistedCreationUpdateAcks/{ackId} {
      // Doc ids are `{userId}__{requestId}`. Allow get of missing docs on the
      // caller's own id prefix (resource is null when the ack does not exist yet).
      allow get: if isStaff()
        && (
          ackId.matches('^' + request.auth.uid + '__.*')
          || (resource != null && resource.data.userId == request.auth.uid)
        );

      allow list: if isStaff()
        && resource.data.userId == request.auth.uid;

      allow create: if isStaff()
        && request.resource.data.userId == request.auth.uid
        && ackId == request.resource.data.userId + '__' + request.resource.data.requestId
        && assistedCreationUpdateAckFieldsValid(request.resource.data);

      allow update: if isStaff()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.requestId == resource.data.requestId
        && request.resource.data.createdAt == resource.data.createdAt
        && ackId == resource.data.userId + '__' + resource.data.requestId
        && assistedCreationUpdateAckFieldsValid(request.resource.data);

      allow delete: if isStaff()
        && resource.data.userId == request.auth.uid
        && ackId == resource.data.userId + '__' + resource.data.requestId;
    }

    match /customerNotifications/{notificationId} {
      allow read: if isCustomer()
        && resource.data.customerUid == request.auth.uid;

      allow create, delete: if false;

      allow update: if isCustomer()
        && resource.data.customerUid == request.auth.uid
        && request.resource.data.customerUid == resource.data.customerUid
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.kind == resource.data.kind
        && request.resource.data.title == resource.data.title
        && request.resource.data.body == resource.data.body
        && request.resource.data.href == resource.data.href
        && request.resource.data.requestId == resource.data.requestId
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["readAt", "updatedAt"])
        && request.resource.data.readAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    match /staffInboxAlertDeliveries/{deliveryId} {
      allow read: if isStaff()
        && resource.data.userId == request.auth.uid;

      allow create: if isStaff()
        && request.resource.data.userId == request.auth.uid
        && staffInboxAlertDeliveryFieldsValid(request.resource.data);

      allow update: if isStaff()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.itemId == resource.data.itemId
        && request.resource.data.kind == resource.data.kind
        && staffInboxAlertDeliveryFieldsValid(request.resource.data);

      allow delete: if isStaff()
        && resource.data.userId == request.auth.uid;
    }

    // Customer uploads (ADR-FP-073) — Admin SDK / callables own all writes.
    match /customerUploads/{uploadId} {
      allow read: if isStaff()
        || (isCustomer() && resource.data.customerUid == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /customerUploadBatches/{batchId} {
      allow read: if isStaff()
        || (isCustomer() && resource.data.customerUid == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /customerUploadRateLimits/{docId} {
      allow read, write: if false;
    }

    match /customerUploadFinalizeLeases/{leaseId} {
      allow read, write: if false;
    }

    match /customerUploadIdempotency/{docId} {
      allow read, write: if false;
    }

    match /etsyRecommendationRequests/{requestId} {
      allow read: if isStaff()
        || (isCustomer() && resource.data.customerUid == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /etsyRecommendationRateLimits/{docId} {
      allow read, write: if false;
    }

    match /etsyRecommendationConfig/{docId} {
      allow read, write: if false;
    }

    // Admin-added Subject / Tone overlays for Portal Etsy wizard autocomplete.
    // Writes only via Admin SDK callables (owner/admin).
    match /etsyRecommendationSuggestions/{suggestionId} {
      allow read: if isSignedIn();
      allow create, update, delete: if false;
    }

    // Customer suggestion requests awaiting Studio review (Customer Requests).
    // Writes only via Admin SDK callables.
    match /etsySuggestionRequests/{requestId} {
      allow read: if isStaff();
      allow create, update, delete: if false;
    }

    match /etsyWebsiteSearchCache/{docId} {
      allow read, write: if false;
    }

    // Assisted Creation requests (Phase 9C). Writes only via Admin SDK callables.
    match /assistedCreationRequests/{requestId} {
      allow read: if isStaff()
        || (isCustomer() && resource.data.customerUid == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /emailDeliveryJobs/{jobId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
