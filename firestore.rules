rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function callerUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function callerIsActive() {
      return isSignedIn() && callerUser().isActive == true;
    }

    function callerRole() {
      return callerUser().role;
    }

    function isOwner() {
      return callerIsActive() && callerRole() == "owner";
    }

    function isAdmin() {
      return callerIsActive() && callerRole() == "admin";
    }

    function isStaff() {
      return callerIsActive() && callerRole() in ["owner", "admin", "helper"];
    }

    function isOwnerOrAdmin() {
      return callerIsActive() && callerRole() in ["owner", "admin"];
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isReadableTeamProfile(role) {
      return role in ["owner", "admin", "helper"];
    }

    function isValidDesignStatus(status) {
      // Catalog statuses plus deprecated queued/printed for legacy document reads.
      return status in ["imported", "processing", "ready", "rejected", "archived", "queued", "printed"];
    }

    function isOptionalString(data, field) {
      return !(field in data) || data[field] is string;
    }

    function isOptionalNumber(data, field) {
      return !(field in data) || data[field] is number;
    }

    function isOptionalBool(data, field) {
      return !(field in data) || data[field] is bool;
    }

    function isOptionalTimestamp(data, field) {
      return !(field in data) || data[field] is timestamp;
    }

    function isValidAiReviewStatus(status) {
      return status in ["pending", "approved", "rejected", "needs_review"];
    }

    function isOptionalMap(data, field) {
      return !(field in data) || data[field] is map;
    }

    function clientAiFieldsUnchanged() {
      return request.resource.data.get("aiSuggestions", null) == resource.data.get("aiSuggestions", null)
        && request.resource.data.get("aiAnalysis", null) == resource.data.get("aiAnalysis", null)
        && request.resource.data.get("aiProcessingStage", null) == resource.data.get("aiProcessingStage", null);
    }

    function designRequiredFieldsValid(data) {
      return data.keys().hasAll([
          "id",
          "title",
          "tags",
          "status",
          "originalPath",
          "thumbnailPath",
          "uploadedBy",
          "createdBy",
          "updatedBy",
          "queueCount",
          "aiProcessed",
          "aiReviewed",
          "createdAt",
          "updatedAt"
        ])
        && data.id is string
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 200
        && data.tags is list
        && data.status is string
        && isValidDesignStatus(data.status)
        && data.originalPath is string
        && data.thumbnailPath is string
        && data.uploadedBy is string
        && data.createdBy is string
        && data.updatedBy is string
        && data.queueCount is int
        && data.queueCount >= 0
        && data.aiProcessed is bool
        && data.aiReviewed is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && isOptionalString(data, "description")
        && isOptionalString(data, "categoryId")
        && isOptionalString(data, "previewPath")
        && isOptionalString(data, "requestedByCustomerId")
        && isOptionalNumber(data, "width")
        && isOptionalNumber(data, "height")
        && isOptionalNumber(data, "dpi")
        && isOptionalNumber(data, "printWidthInches")
        && isOptionalNumber(data, "printHeightInches")
        && isOptionalBool(data, "printAspectRatioLocked")
        && isOptionalNumber(data, "metadataDpiX")
        && isOptionalNumber(data, "metadataDpiY")
        && isOptionalNumber(data, "effectiveDpi")
        && isOptionalString(data, "printSizeSource")
        && isOptionalString(data, "aiReviewStatus")
        && (!("aiReviewStatus" in data) || isValidAiReviewStatus(data.aiReviewStatus))
        && isOptionalTimestamp(data, "aiReviewedAt")
        && isOptionalString(data, "aiReviewedBy")
        && isOptionalString(data, "aiReviewVersion")
        && isOptionalString(data, "aiReviewNotes")
        && isOptionalNumber(data, "aiReviewConfidence")
        && isOptionalString(data, "previousStatus")
        && isOptionalTimestamp(data, "archivedAt")
        && isOptionalString(data, "archivedBy")
        && isOptionalString(data, "aiProcessingStage")
        && isOptionalMap(data, "aiSuggestions")
        && isOptionalMap(data, "aiAnalysis");
    }

    function categoryRequiredFieldsValid(data) {
      return data.keys().hasAll([
          "id",
          "name",
          "sortOrder",
          "isActive",
          "createdBy",
          "updatedBy",
          "createdAt",
          "updatedAt"
        ])
        && data.id is string
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 80
        && data.sortOrder is int
        && data.isActive is bool
        && data.createdBy is string
        && data.updatedBy is string
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && isOptionalString(data, "description");
    }

    function isValidCatalogTagStatus(status) {
      return status in ["approved", "archived"];
    }

    function isValidTagStringList(values) {
      return values is list
        && values.size() <= 50;
    }

    function tagRequiredFieldsValid(data) {
      return data.keys().hasOnly([
          "id",
          "name",
          "aliases",
          "preferredWhen",
          "status",
          "createdBy",
          "updatedBy",
          "createdAt",
          "updatedAt"
        ])
        && data.keys().hasAll([
          "id",
          "name",
          "aliases",
          "preferredWhen",
          "status",
          "createdBy",
          "updatedBy",
          "createdAt",
          "updatedAt"
        ])
        && data.id is string
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 40
        && isValidTagStringList(data.aliases)
        && data.preferredWhen is string
        && data.preferredWhen.size() > 0
        && data.preferredWhen.size() <= 500
        && data.status is string
        && isValidCatalogTagStatus(data.status)
        && data.createdBy is string
        && data.updatedBy is string
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPrintRequestStatus(status) {
      return status in ["draft", "active", "completed", "archived"];
    }

    function isValidPrintRequestItemStatus(status) {
      return status in ["pending", "queued", "in_progress", "printed", "done", "canceled"];
    }

    function isValidPrintRequestAssignment(data) {
      return (data.isInternal == true && !("customerId" in data) && !("guestCustomerId" in data))
        || (data.isInternal == false
          && (
            (("customerId" in data) && !("guestCustomerId" in data) && data.customerId is string && data.customerId.size() > 0)
            || (!("customerId" in data) && ("guestCustomerId" in data) && data.guestCustomerId is string && data.guestCustomerId.size() > 0)
          ));
    }

    function printRequestRequiredFieldsValid(data) {
      return data.keys().hasOnly([
          "name",
          "customerId",
          "guestCustomerId",
          "isInternal",
          "status",
          "itemCount",
          "notes",
          "createdBy",
          "updatedBy",
          "createdAt",
          "updatedAt"
        ])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 200
        && isOptionalString(data, "customerId")
        && isOptionalString(data, "guestCustomerId")
        && data.isInternal is bool
        && data.status is string
        && isValidPrintRequestStatus(data.status)
        && data.itemCount is int
        && data.itemCount >= 0
        && isOptionalString(data, "notes")
        && data.createdBy is string
        && data.updatedBy is string
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && isValidPrintRequestAssignment(data);
    }

    function printRequestItemRequiredFieldsValid(data) {
      return data.keys().hasOnly([
          "id",
          "printRequestId",
          "designId",
          "quantity",
          "printWidthInches",
          "printHeightInches",
          "sizeLabel",
          "notes",
          "status",
          "addedBy",
          "printedAt",
          "printedBy",
          "completedAt",
          "createdAt",
          "updatedAt"
        ])
        && data.id is string
        && data.id.size() > 0
        && data.printRequestId is string
        && data.printRequestId.size() > 0
        && data.designId is string
        && data.designId.size() > 0
        && data.quantity is int
        && data.quantity > 0
        && isOptionalNumber(data, "printWidthInches")
        && isOptionalNumber(data, "printHeightInches")
        && isOptionalString(data, "sizeLabel")
        && isOptionalString(data, "notes")
        && data.status is string
        && isValidPrintRequestItemStatus(data.status)
        && data.addedBy is string
        && data.addedBy.size() > 0
        && isOptionalTimestamp(data, "printedAt")
        && isOptionalString(data, "printedBy")
        && isOptionalTimestamp(data, "completedAt")
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function printRequestParentExists(printRequestId) {
      return exists(/databases/$(database)/documents/printRequests/$(printRequestId));
    }

    function isReadyDesign(designId) {
      return exists(/databases/$(database)/documents/designs/$(designId))
        && get(/databases/$(database)/documents/designs/$(designId)).data.status == "ready";
    }

    function customerRequiredFieldsValid(data) {
      return data.keys().hasOnly([
          "id",
          "userId",
          "displayName",
          "email",
          "notes",
          "isGuest",
          "totalPrintRequests",
          "totalRequests",
          "totalApprovedRequests",
          "createdAt",
          "updatedAt"
        ])
        && data.id is string
        && data.id.size() > 0
        && data.displayName is string
        && data.displayName.size() > 0
        && data.isGuest is bool
        && data.totalPrintRequests is int
        && data.totalPrintRequests >= 0
        && isOptionalString(data, "userId")
        && isOptionalString(data, "email")
        && isOptionalString(data, "notes")
        && isOptionalNumber(data, "totalRequests")
        && isOptionalNumber(data, "totalApprovedRequests")
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow read: if isSelf(userId)
        || (isOwner() && isReadableTeamProfile(resource.data.role))
        || (isAdmin() && resource.data.role in ["admin", "helper"]);

      allow create, update, delete: if false;
    }

    match /designs/{designId} {
      allow read: if isStaff();

      allow create: if isStaff()
        && designRequiredFieldsValid(request.resource.data)
        && request.resource.data.id == designId
        && request.resource.data.uploadedBy == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid;

      allow update: if isStaff()
        && designRequiredFieldsValid(request.resource.data)
        && request.resource.data.id == designId
        && request.resource.data.id == resource.data.id
        && request.resource.data.uploadedBy == resource.data.uploadedBy
        && (!("createdBy" in resource.data) || request.resource.data.createdBy == resource.data.createdBy)
        && (!("createdAt" in resource.data) || request.resource.data.createdAt == resource.data.createdAt)
        && request.resource.data.updatedBy == request.auth.uid
        && clientAiFieldsUnchanged();

      allow delete: if false;
    }

    match /categories/{categoryId} {
      allow read: if isStaff();

      allow create: if isOwnerOrAdmin()
        && categoryRequiredFieldsValid(request.resource.data)
        && request.resource.data.id == categoryId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid;

      allow update: if isOwnerOrAdmin()
        && categoryRequiredFieldsValid(request.resource.data)
        && request.resource.data.id == categoryId
        && request.resource.data.id == resource.data.id
        && (!("createdBy" in resource.data) || request.resource.data.createdBy == resource.data.createdBy)
        && (!("createdAt" in resource.data) || request.resource.data.createdAt == resource.data.createdAt)
        && request.resource.data.updatedBy == request.auth.uid;

      allow delete: if false;
    }

    match /tags/{tagId} {
      allow read: if isStaff();

      allow create: if isOwnerOrAdmin()
        && tagRequiredFieldsValid(request.resource.data)
        && request.resource.data.id == tagId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid;

      allow update: if isOwnerOrAdmin()
        && tagRequiredFieldsValid(request.resource.data)
        && request.resource.data.id == tagId
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedBy == request.auth.uid;

      allow delete: if false;
    }

    match /customers/{customerId} {
      allow read: if isStaff();

      allow create: if isStaff()
        && customerRequiredFieldsValid(request.resource.data)
        && request.resource.data.id == customerId;

      allow update: if isStaff()
        && customerRequiredFieldsValid(request.resource.data)
        && request.resource.data.id == customerId
        && request.resource.data.id == resource.data.id
        && (!("userId" in resource.data) || request.resource.data.userId == resource.data.userId)
        && (!("isGuest" in resource.data) || request.resource.data.isGuest == resource.data.isGuest)
        && (!("createdAt" in resource.data) || request.resource.data.createdAt == resource.data.createdAt);

      allow delete: if false;
    }

    match /printRequests/{printRequestId} {
      allow read: if isStaff();

      allow create: if isStaff()
        && printRequestRequiredFieldsValid(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid;

      allow update: if isStaff()
        && printRequestRequiredFieldsValid(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedBy == request.auth.uid;

      allow delete: if isStaff();
    }

    match /printRequestItems/{printRequestItemId} {
      allow read: if isStaff();

      allow create: if isStaff()
        && printRequestItemRequiredFieldsValid(request.resource.data)
        && request.resource.data.id == printRequestItemId
        && request.resource.data.addedBy == request.auth.uid
        && printRequestParentExists(request.resource.data.printRequestId)
        && isReadyDesign(request.resource.data.designId);

      allow update: if isStaff()
        && printRequestItemRequiredFieldsValid(request.resource.data)
        && request.resource.data.id == printRequestItemId
        && request.resource.data.id == resource.data.id
        && request.resource.data.printRequestId == resource.data.printRequestId
        && request.resource.data.designId == resource.data.designId
        && request.resource.data.addedBy == resource.data.addedBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt is timestamp
        && printRequestParentExists(request.resource.data.printRequestId)
        && isReadyDesign(request.resource.data.designId);

      allow delete: if isStaff();
    }

    match /settings/{settingId} {
      allow read: if isStaff() && settingId == "aiEnrichment";
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
