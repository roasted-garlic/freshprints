# Fresh Prints Studio (Vite / Electron renderer)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Portal catalog Algolia — search-only credentials (same index as Portal for this Firebase project).
# Never put an Algolia admin/write key in Studio.
# VITE_USE_ALGOLIA_CATALOG_SEARCH=false
# VITE_ALGOLIA_APP_ID=
# VITE_ALGOLIA_SEARCH_API_KEY=
# VITE_ALGOLIA_INDEX_NAME=portal_catalog_ready_dev
# Smart Filters UI (Design Library managed search) — default OFF; set true for DEV QA after Slice 3 index.
# VITE_USE_SMART_FILTERS=true

# Derivative-locus diagnostic banner/logging — leave unset for normal DEV and all release builds.
# Only set to 1 for intentional evidence packages (never bake into CI release).
# VITE_FP_DERIVATIVE_LOCUS_DIAG=1
