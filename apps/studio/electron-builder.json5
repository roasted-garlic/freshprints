// @see - https://www.electron.build/configuration/configuration
{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.freshprints.app",
  // electron-builder's auto-detection only checks <projectDir>/node_modules/electron, which
  // does not exist here because npm workspaces hoist `electron` to the repo root. Pinning
  // electronVersion explicitly skips that broken lookup (see electron-builder issue #3984).
  "electronVersion": "30.5.1",
  // Default npmRebuild runs `npm install --production` scoped to apps/studio, but npm
  // workspaces hoist all deps to the repo root (apps/studio has no local node_modules), so that
  // step prunes/corrupts the root tree instead. `sharp` (the only native dep) is externalized
  // from the Vite bundle already; Mac CI installs the matching darwin-${arch} sharp binary via
  // prepare-sharp-for-darwin-arch.mjs before each arch package, so no native rebuild is needed
  // at package time.
  "npmRebuild": false,
  "asar": true,
  // sharp ships platform-native `.node` binaries that must be loadable outside the asar archive.
  "asarUnpack": [
    "**/node_modules/sharp/**",
    "**/node_modules/@img/**"
  ],
  "productName": "Fresh Prints",
  "copyright": "Copyright 2026 Fresh Prints",
  "directories": {
    "output": "release/${version}"
  },
  // GitHub Releases on the existing public roasted-garlic/freshprints repo — safe without any
  // embedded credential because the repo is public (confirmed via GitHub API, "private": false).
  // electron-builder derives the stable vs. prerelease feed automatically from whether `version`
  // has a semver prerelease tag (e.g. "1.0.0-beta.1" publishes generic release + prerelease
  // channel metadata; "1.0.0" publishes stable latest.yml / latest-mac.yml). No token is required
  // for a public repo's release *assets* to be read anonymously by electron-updater at runtime.
  "publish": {
    "provider": "github",
    "owner": "roasted-garlic",
    "repo": "freshprints"
  },
  "files": [
    "dist",
    "dist-electron"
  ],
  "mac": {
    // Studio 1.0.4 ships native Intel (x64) and Apple Silicon (arm64) packages.
    // Universal is deferred; separate artifacts + merged latest-mac.yml keep updater arch-safe.
    "target": [
      {
        "target": "dmg",
        "arch": [
          "x64",
          "arm64"
        ]
      },
      {
        "target": "zip",
        "arch": [
          "x64",
          "arm64"
        ]
      }
    ],
    // electron-builder converts PNG → ICNS on macOS runners from the approved brand asset.
    "icon": "icon.png",
    // Space-free, arch-explicit names so GitHub Release assets match updater paths exactly
    // (spaced "${productName}-..." becomes Fresh.Prints-* under `gh release upload`).
    "artifactName": "Fresh-Prints-Mac-${arch}-${version}-Installer.${ext}",
    "category": "public.app-category.business",
    // Electron 30 supports macOS 10.15+; pin Big Sur floor for the owner's Intel Mac (11.7.11).
    // Do not raise above Big Sur without an explicit owner decision.
    "minimumSystemVersion": "11.0",
    // Internal Mac distribution for Studio 1.0.4: ad-hoc sign (identity "-") so the .app is
    // structurally valid (sealed CodeResources). This is NOT Developer ID and NOT notarized.
    // identity:null previously skipped @electron/osx-sign and left incomplete linker signatures,
    // which macOS reports as "damaged" ("code has no resources but signature indicates they must
    // be present"). Requires electron-builder >= 26.0.13 for native ad-hoc identity support.
    "identity": "-",
    // Least-complex internal path: avoid hardened-runtime Team ID / library-validation failures
    // with Electron Framework under ad-hoc signing. Future Developer ID phase will revisit.
    "hardenedRuntime": false,
    "gatekeeperAssess": false
  },
  "dmg": {
    "artifactName": "Fresh-Prints-Mac-${arch}-${version}-Installer.${ext}"
  },
  "win": {
    "icon": "icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "Fresh-Prints-Windows-${version}-Setup.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false
  },
  "linux": {
    "icon": "icon.png",
    "target": [
      "AppImage"
    ],
    "artifactName": "Fresh-Prints-Linux-${version}.${ext}"
  }
}
