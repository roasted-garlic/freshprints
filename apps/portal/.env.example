# Fresh Prints Request Portal (Next.js)
# Local: copy to .env.local (dev) or .env.production.local (prod builds). Both are gitignored.
# Production App Hosting: do NOT put values in apphosting.yaml — store each as a Cloud Secret
# Manager secret with the same name and reference via `secret:` in apps/portal/apphosting.yaml.
#   firebase apphosting:secrets:set NEXT_PUBLIC_FIREBASE_API_KEY --project fresh-prints-prod
# (repeat for each variable below; grantaccess if secrets were created outside that CLI flow)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Web Push (Firebase Console → Project settings → Cloud Messaging → Web Push certificates)
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# Optional absolute Portal origin for Open Graph / Twitter absolute image URLs (no trailing slash).
# Defaults: fresh-prints-dev → https://myprintrequest.dev; other production project → https://myprintrequest.com;
# local/unknown → http://localhost:3100. Set explicitly on production App Hosting when needed
# (Secret Manager secret NEXT_PUBLIC_PORTAL_ORIGIN for App Hosting; local file for local builds).
# NEXT_PUBLIC_PORTAL_ORIGIN=https://myprintrequest.dev
# Google Analytics (GA4) Measurement ID. Optional. Analytics stays fully inert unless
# this is set AND the resolved origin is the production customer host (myprintrequest.com).
# Do not set this in fresh-prints-dev or any non-production environment.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Stage 1b Algolia catalog search (search-only credentials — never admin/write keys).
# Enable only after Secret Manager + Functions sync are live and the index is reconciled.
# NEXT_PUBLIC_USE_ALGOLIA_CATALOG_SEARCH=true
# NEXT_PUBLIC_ALGOLIA_APP_ID=
# NEXT_PUBLIC_ALGOLIA_SEARCH_API_KEY=
# NEXT_PUBLIC_ALGOLIA_INDEX_NAME=portal_catalog_ready_dev
